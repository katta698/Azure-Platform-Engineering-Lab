# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
tenant_id       = "00000000-0000-0000-0000-000000000000"
subscription_id = "00000000-0000-0000-0000-000000000000" # sub-lab-dev

# ha_mode  = "ZoneRedundant"          # or "SameZone" — see variables.tf
# sku_name = "GP_Standard_D2ds_v5"    # 2 vCores; the guardrail denies more

# Measured 2026-11-22: southcentralus refuses ZoneRedundant on this
# subscription with MultiAzHaIsOfferRestricted, so the lab runs SameZone.
ha_mode = "SameZone"
