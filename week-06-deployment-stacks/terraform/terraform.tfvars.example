# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

tenant_id       = "00000000-0000-0000-0000-000000000000"
subscription_id = "00000000-0000-0000-0000-000000000000" # sub-lab-dev

location = "southcentralus"

# Storage account names are globally unique. Pick something unlikely to collide.
control_storage_account_name = "stwk06ctrlxxxxxx"
