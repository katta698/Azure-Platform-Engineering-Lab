# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
tenant_id       = "00000000-0000-0000-0000-000000000000"
subscription_id = "00000000-0000-0000-0000-000000000000" # sub-lab-dev

# An EXISTING public key. Azure requires a key or a password on a Linux VM,
# and this lab does not create passwords. Nothing can use it: no inbound port
# is open on the VM.
# ssh_public_key_path = "~/.ssh/id_ed25519.pub"
