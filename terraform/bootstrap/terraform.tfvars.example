// Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored and must
// stay that way — every value below is an account identifier.
//
// Where each one comes from:
//
//   tenant_id, sandbox_subscription_id
//     az account show --query "{tenant:tenantId, sub:id}" -o json
//
//   billing_account_name
//     az billing account list --query "[0].name" -o tsv
//
//   billing_profile_name
//     az billing profile list --account-name "<billing_account_name>" --query "[0].name" -o tsv
//
//   invoice_section_name
//     az billing invoice section list \
//       --account-name "<billing_account_name>" \
//       --profile-name "<billing_profile_name>" \
//       --query "[0].name" -o tsv

tenant_id               = "00000000-0000-0000-0000-000000000000"
sandbox_subscription_id = "00000000-0000-0000-0000-000000000000"

billing_account_name = "00000000-0000-0000-0000-000000000000:00000000-0000-0000-0000-000000000000_0000-00-00"
billing_profile_name = "XXXX-XXXX-XXX-XXX"
invoice_section_name = "XXXX-XXXX-XXX-XXX"

budget_alert_emails = ["your-email@example.com"]

// Leave false for the first apply. Flip to true only after the management group
// tree and the CI identity have applied cleanly, so a rejection from the
// Subscription Alias API is an isolated failure.
create_subscriptions = false

// Two federated credentials are consumed per entry, and Entra allows 20 per
// application. Add each week's workspace here before that workspace's first run.
hcp_workspaces = [
  "azure-bootstrap",
]
