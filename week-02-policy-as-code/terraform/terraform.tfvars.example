// Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
//
//   az account show --query "{tenant:tenantId}" -o tsv
//   az account list --all --query "[?name=='sub-lab-dev'].id" -o tsv

tenant_id       = "00000000-0000-0000-0000-000000000000"
subscription_id = "00000000-0000-0000-0000-000000000000"

// Stage 1. deploy.sh sets both of these per stage; the values here are only
// the defaults for a bare `terraform apply`.
enable_remediation      = false
grant_remediation_roles = true
