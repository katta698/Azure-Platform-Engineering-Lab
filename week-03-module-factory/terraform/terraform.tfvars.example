# Both IDs are read from `az account show`. They are not in this file, not in
# the state consumers can see, and not in any committed .tf.

tenant_id       = "00000000-0000-0000-0000-000000000000"
subscription_id = "00000000-0000-0000-0000-000000000000" # sub-lab-dev

location = "southcentralus"
